{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux-extension.schema.json",
  "manifestVersion": 1,
  "id": "agent-usage",
  "name": "Agent Usage",
  "version": "0.1.0",
  "description": "Live Claude Code token usage and cost dashboard for the cmux Dock.",
  "icon": "gauge",
  "build": [
    {
      "command": ["./scripts/install-dependencies.sh"]
    }
  ],
  "panes": [
    {
      "id": "live",
      "title": "Live usage",
      "command": [
        "./scripts/run-ccusage.sh",
        "blocks",
        "--live",
        "--offline"
      ]
    },
    {
      "id": "daily",
      "title": "Daily report",
      "command": ["./scripts/run-ccusage.sh", "daily", "--offline"]
    }
  ]
}
